# Production (cPanel). Zet als .env in shared/ op de server — nooit committen.
APP_NAME="Intake Engine"
APP_ENV=production
APP_KEY=            # genereer op server: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Europe/Amsterdam
APP_URL=https://intake-engine.nl
APP_LOCALE=nl

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=intake_engine_production_session
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
MEDIA_DISK=local
# Optioneel S3 (BL-013): MEDIA_DISK=s3 + AWS-vars hieronder. Geen secrets in git.
# Historische rijen blijven op hun opgeslagen disk+path; geen bestandsmigratie.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# BL-004: smtp verplicht voor klantlink-mails (log-mailer = geen mail, ADR-0002).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@intake-engine.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Publieke interesse-CTA. Leeg = wel bewaren, geen interne e-mailmelding.
PRODUCT_INTEREST_MAIL_TO=info@jpwebcreation.nl
PRODUCT_INTEREST_THROTTLE_PER_HOUR=5
PRODUCT_INTEREST_RETENTION_DAYS=365

AI_PROVIDER=null
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
# Fail-closed voor AI_PROVIDER=openai: stel minstens dag of maand in.
AI_BUDGET_DAILY_CENTS=
AI_BUDGET_MONTHLY_CENTS=
AI_BUDGET_RESERVE_CENTS_PER_CALL=1
AI_BUDGET_INPUT_CENTS_PER_1K_TOKENS=
AI_BUDGET_OUTPUT_CENTS_PER_1K_TOKENS=
AI_BUDGET_IMAGE_CENTS_PER_IMAGE=
# Vereist voor de foto-afleiding in template v6. Een AI_API_KEY alleen is niet genoeg:
# zonder deze vlag slaat DerivePhotoAnswers over en blijft elke afleidbare vraag staan.
AI_PHOTO_INFERENCE_ENABLED=false
AI_PHOTO_INFERENCE_MAX_IMAGES=2
# Minimale zekerheid voor een zichtbare, nog te bevestigen installateursconstatering.
AI_PHOTO_OBSERVATION_MIN_CONFIDENCE=0.65
# Leest de reden van de aanvraag en leidt daaruit functie, aantal gewenste ruimtes en
# ruimtetypes af. Losse vlag: tekst gaat naar de provider, foto's niet per se.
AI_TEXT_INFERENCE_ENABLED=false
# Dossierbrede kandidaatopstellingen en gerichte klantopdrachten. Alleen activeren
# na dezelfde privacy- en budgetcontrole als andere externe AI-functies.
AI_DOSSIER_SYNTHESIS_ENABLED=false
AI_DOSSIER_MODEL=gpt-5.6-terra
AI_DOSSIER_MAX_IMAGES=12

# Metadata-vrije JPEG-varianten voor dossierweergave en AI-analyse.
INTAKE_DOSSIER_MAX_LONG_EDGE=2048
INTAKE_DOSSIER_JPEG_QUALITY=82
INTAKE_ANALYSIS_MAX_LONG_EDGE=1536
INTAKE_ANALYSIS_JPEG_QUALITY=80

PDOK_ENABLED=true
PDOK_SEARCH_BASE_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
PDOK_BAG_BASE_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
PDOK_TIMEOUT_SECONDS=5
PDOK_AERIAL_ENABLED=true
PDOK_AERIAL_WMS_URL=https://service.pdok.nl/hwh/luchtfotorgb/wms/v1_0
PDOK_AERIAL_LAYER=Actueel_orthoHR
PDOK_AERIAL_TIMEOUT_SECONDS=4
PDOK_AERIAL_WIDTH=900
PDOK_AERIAL_HEIGHT=600
PDOK_AERIAL_GROUND_WIDTH_METERS=180

# Kadaster BAG API Individuele Bevragingen. Gezaghebbende, near-realtime BAG-kenmerken
# met exacte bevraging op postcode + huisnummer. Zonder key of bij storing valt de
# verrijking terug op de open PDOK-route, dus dit is optioneel.
# LET OP: de key hoort in de shared .env per omgeving, nooit in de repo.
BAG_API_ENABLED=false
BAG_API_BASE_URL=https://api.bag.kadaster.nl/lvbag/individuelebevragingen/v2
BAG_API_KEY=
BAG_API_TIMEOUT_SECONDS=5

# EP-Online (RVO) — geregistreerde energielabels. Levert de isolatie-indicatie (via de
# energiebehoefte) en het woningtype, waarmee twee vragen vervallen. Key aanvragen via
# epbdwebservices.rvo.nl; die is persoonlijk en hoort nooit in de repo.
# Geen label bij een adres = de vragen blijven gewoon staan.
EP_ONLINE_ENABLED=false
EP_ONLINE_BASE_URL=https://public.ep-online.nl
EP_ONLINE_KEY=
EP_ONLINE_TIMEOUT_SECONDS=5

# 3DBAG (TU Delft) — pandgeometrie: dakvorm en gevelhoogte bij het BAG-pand.
# Open data onder CC BY 4.0, dus opslaan en tonen in het dossier mag mits de bron
# vermeld blijft. Levert context voor de installateur, geen antwoorden.
THREEDBAG_ENABLED=true
THREEDBAG_BASE_URL=https://api.3dbag.nl
THREEDBAG_TIMEOUT_SECONDS=5

# Herinnering stilliggende intake (BL-015).
INTAKE_REMINDER_DAYS=3
INTAKE_FOLLOW_UP_MAX_ROUNDS=3
INTAKE_FOLLOW_UP_MAX_ITEMS=5
INTAKE_FOLLOW_UP_MAX_PHOTOS=5
INTAKE_FOLLOW_UP_MAX_DOCUMENTS=3

# Hard purge na soft delete (BL-009).
INTAKE_SOFT_DELETE_RETENTION_DAYS=30

# Tijdelijke installateursdemo op homepage. Standaard aan; false blokkeert nieuwe starts.
DEMO_ENABLED=true
DEMO_TTL_HOURS=2
DEMO_USER_EMAIL=demo@intake-engine.invalid
DEMO_THROTTLE_PER_HOUR=5
