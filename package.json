{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:js": "vitest run",
        "test:js:watch": "vitest",
        "e2e:fixtures": "node tests/e2e/fixtures/generate-fixtures.mjs",
        "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
        "test:e2e:install": "playwright install chromium --with-deps",
        "test:e2e:customer-tasks": "playwright test tests/e2e/customer-task-draft-bundle.spec.ts",
        "test:e2e:cta-outcome": "playwright test tests/e2e/installer-workspace.spec.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.13.10",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "happy-dom": "^15.11.7",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "sharp": "^0.34.2",
        "tailwindcss": "^3.1.0",
        "typescript": "^5.8.2",
        "vite": "^8.0.0",
        "vitest": "^3.2.4"
    }
}
